<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 测试日志同样固定输出关联标识与来源，方便在测试输出中串联请求链路 -->
    <property name="LOG_PATTERN"
              value="%d{HH:mm:ss.SSS} %-5level [%thread] [corrId=%X{correlationId:-},src=%X{correlationSource:-}] %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
