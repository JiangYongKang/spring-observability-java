<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 测试日志统一携带：关联标识 / 路由模板 / 错误分类 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] correlationId=%X{correlationId:--} routeTemplate=%X{routeTemplate:--} errorCategory=%X{errorCategory:--} logger=%logger{40} - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
