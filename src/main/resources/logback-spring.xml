<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 日志模式固定输出 MDC 中的关联标识及其来源，便于在同步与异步线程日志间串联 -->
    <property name="LOG_PATTERN"
              value="%d{HH:mm:ss.SSS} %-5level [%thread] [corrId=%X{correlationId:-},src=%X{correlationSource:-}] %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
